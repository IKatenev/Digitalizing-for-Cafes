{
  "name": "package",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier . --write",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run format",
    "test:chrome": "playwright test --headed --project=chromium",
    "test:firefox": "playwright test --headed --project=firefox",
    "test:safari": "playwright test --headed --project=webkit",
    "predev": "node scripts/prepare-images.mjs",
    "prebuild": "node scripts/prepare-images.mjs",
    "format:check": "prettier . --check",
    "test:unit": "node --test tests/*.test.mjs",
    "audit:performance": "node scripts/audit-performance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.7.4",
    "sass": "^1.96.0",
    "sharp": "^0.35.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "vite": "^7.2.4",
    "vite-plugin-html": "^3.2.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
