{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "absolut-pos-enquiries",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ikatenev.github.io"
  },
  "ratelimits": [
    { "name": "ENQUIRY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
